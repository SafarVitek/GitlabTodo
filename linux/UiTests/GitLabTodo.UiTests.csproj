<Project Sdk="Microsoft.NET.Sdk">

  <!-- Clicks through the app without a display, run with dotnet run in linux/UiTests. Not part of the Nix package. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GitLabTodo.UiTests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GitLabTodo/GitLabTodo.csproj" />
  </ItemGroup>

</Project>
