<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logic tests as a plain console program, like the macOS ones, run with dotnet run in linux/Tests. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GitLabTodo.Tests</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../GitLabTodo.Core/GitLabTodo.Core.csproj" />
  </ItemGroup>

</Project>
