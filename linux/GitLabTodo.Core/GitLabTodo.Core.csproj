<Project Sdk="Microsoft.NET.Sdk">

  <!-- Data, GitLab API and the work plan, without any UI, so the tests run without a display. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GitLabTodo.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GitLabTodo.Tests" />
  </ItemGroup>

</Project>
