<Project Sdk="Microsoft.NET.Sdk">

  <!-- Data, GitLab API and the work plan, without any UI, so the tests run without a display. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GitLabTodo.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GitLabTodo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- D-Bus for the keyring; the same version Avalonia brings, so the Nix dependencies stay as they are. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
  </ItemGroup>

</Project>
