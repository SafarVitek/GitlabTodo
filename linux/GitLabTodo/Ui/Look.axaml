<!-- The app's look on top of Fluent, after VaultSSH: layered graphite or paper surfaces, raised buttons with a hairline,
     fields set into the base color, IBM Plex Sans, and the same blue accent as the macOS app.
     Colors the code draws with come from the App* resources here too, so both follow the light or dark theme. -->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitLabTodo.Ui.Look">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- Layers like VaultSSH: the content on the base, sidebar and detail on a surface, controls raised. -->
          <Color x:Key="AppBackgroundColor">#FBFBFC</Color>
          <Color x:Key="AppSidebarColor">#F3F4F6</Color>
          <Color x:Key="AppSurfaceColor">#F3F4F6</Color>
          <Color x:Key="AppRaisedColor">#FFFFFF</Color>
          <Color x:Key="AppSelectedColor">#E8EAEE</Color>
          <Color x:Key="AppLineColor">#D0D4DB</Color>
          <Color x:Key="AppLineSoftColor">#E3E6EA</Color>
          <Color x:Key="AppTextColor">#15171C</Color>
          <SolidColorBrush x:Key="AppBackground" Color="#FBFBFC" />
          <SolidColorBrush x:Key="AppHover" Color="#0D15171C" />
          <SolidColorBrush x:Key="AppPressed" Color="#1A15171C" />
          <SolidColorBrush x:Key="AppWindowClose" Color="#E5484D" />

          <SolidColorBrush x:Key="ButtonBackground" Color="#E8EAEE" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#DFE2E7" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#D6DAE0" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E8EAEE" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#15171C" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#15171C" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#15171C" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D0D4DB" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#D0D4DB" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#D0D4DB" />

          <!-- Fields sit on the base color, a step below the card around them. -->
          <SolidColorBrush x:Key="TextControlBackground" Color="#FBFBFC" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#FBFBFC" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#FBFBFC" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#D0D4DB" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#B9BEC7" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0A84FF" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#80858F" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#80858F" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#80858F" />

          <SolidColorBrush x:Key="ComboBoxBackground" Color="#FBFBFC" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#FBFBFC" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D0D4DB" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#B9BEC7" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D0D4DB" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#E8EAEE" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#E8EAEE" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#DFE2E7" />

          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#D0D4DB" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#E8EAEE" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#D0D4DB" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#15171C" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#D0D4DB" />

          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#D0D4DB" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#B9BEC7" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
          <!-- Layers like VaultSSH: the content on the base, sidebar and detail on a surface, controls raised. -->
          <Color x:Key="AppBackgroundColor">#16181D</Color>
          <Color x:Key="AppSidebarColor">#1C1F25</Color>
          <Color x:Key="AppSurfaceColor">#1E2128</Color>
          <Color x:Key="AppRaisedColor">#23262E</Color>
          <Color x:Key="AppSelectedColor">#272B33</Color>
          <Color x:Key="AppLineColor">#343944</Color>
          <Color x:Key="AppLineSoftColor">#272B33</Color>
          <Color x:Key="AppTextColor">#E7E9EE</Color>
          <SolidColorBrush x:Key="AppBackground" Color="#16181D" />
          <SolidColorBrush x:Key="AppHover" Color="#12FFFFFF" />
          <SolidColorBrush x:Key="AppPressed" Color="#20FFFFFF" />
          <SolidColorBrush x:Key="AppWindowClose" Color="#E5484D" />

          <SolidColorBrush x:Key="ButtonBackground" Color="#272B33" />
          <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#2F343D" />
          <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#373C46" />
          <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#272B33" />
          <SolidColorBrush x:Key="ButtonForeground" Color="#E7E9EE" />
          <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#E7E9EE" />
          <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E7E9EE" />
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#343944" />
          <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#343944" />
          <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#343944" />

          <!-- Fields sit on the base color, a step below the card around them. -->
          <SolidColorBrush x:Key="TextControlBackground" Color="#16181D" />
          <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#16181D" />
          <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#16181D" />
          <SolidColorBrush x:Key="TextControlBorderBrush" Color="#343944" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#454B57" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#0A84FF" />
          <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6E7380" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundPointerOver" Color="#6E7380" />
          <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#6E7380" />

          <SolidColorBrush x:Key="ComboBoxBackground" Color="#16181D" />
          <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#16181D" />
          <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#343944" />
          <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#454B57" />
          <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#22252C" />
          <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#343944" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#272B33" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#272B33" />
          <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2F343D" />

          <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#22252C" />
          <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#343944" />
          <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#272B33" />
          <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#22252C" />
          <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#343944" />
          <SolidColorBrush x:Key="ToolTipBackground" Color="#22252C" />
          <SolidColorBrush x:Key="ToolTipForeground" Color="#E7E9EE" />
          <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#343944" />

          <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#343944" />
          <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#454B57" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="Transparent" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#FFFFFF" />
          <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#FFFFFF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>
      <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackground}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Icon buttons and quiet actions: no box until the pointer is over them. -->
  <Style Selector="Button.subtle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.subtle /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.subtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppHover}" />
  </Style>
  <Style Selector="Button.subtle:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppPressed}" />
  </Style>

  <!-- The window's close button turns red under the pointer. -->
  <Style Selector="Button.window-close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppWindowClose}" />
  </Style>
  <Style Selector="Button.window-close:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AppWindowClose}" />
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <!-- Filled buttons with their own color keep it, a little lighter under the pointer. -->
  <Style Selector="Button.filled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.filled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.88" />
  </Style>
  <Style Selector="Button.filled:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Opacity" Value="0.78" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <!-- A field inside a card: no frame of its own. -->
  <Style Selector="TextBox.bare /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="TextBox.bare">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="2,4" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="MinHeight" Value="34" />
  </Style>

  <!-- Switches for settings, without the „On“ and „Off“ text next to them. -->
  <Style Selector="ToggleSwitch">
    <Setter Property="OnContent" Value="{x:Null}" />
    <Setter Property="OffContent" Value="{x:Null}" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="10,5" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Padding" Value="8,5" />
  </Style>
</Styles>
